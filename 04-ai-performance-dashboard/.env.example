# ─────────────────────────────────────────────
#  Copie este arquivo para .env e preencha com
#  suas credenciais reais. NUNCA commite .env.
# ─────────────────────────────────────────────

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automacoes_db
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_aqui

# Modo mock: "true" usa dados simulados, "false" conecta ao banco real
USE_MOCK_DATA=true

# KPI: parâmetros para cálculo de ROI
HOURLY_RATE_BRL=80.0
HOURS_SAVED_PER_EXECUTION=0.5
