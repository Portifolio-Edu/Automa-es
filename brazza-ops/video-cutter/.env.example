# ── FFmpeg ──────────────────────────────────────────────────────────────────
SILENCE_THRESHOLD=-40       # dB — limiar de silêncio
SILENCE_DURATION=0.5        # segundos de silêncio mínimo para considerar corte
MIN_CLIP_DURATION=1.0       # segundos — descarta trechos menores que isso

# ── Google OAuth2 ────────────────────────────────────────────────────────────
# Criar em console.cloud.google.com → APIs & Services → Credentials
# Tipo: Web application
# Authorized redirect URIs: https://video-cutter.eduandreazza.site/auth/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# API key opcional (console.cloud.google.com → API Keys)
# Melhora tracking de quota do Drive Picker; funciona sem ela
GOOGLE_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=https://video-cutter.eduandreazza.site
SECRET_KEY=troque-por-uma-string-aleatoria-de-32-chars
