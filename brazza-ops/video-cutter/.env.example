# Silence detection
SILENCE_THRESHOLD=-40        # dB — mais negativo = só detecta silêncio mais profundo
SILENCE_DURATION=0.5         # segundos de silêncio mínimo para considerar corte
MIN_CLIP_DURATION=1.0        # segundos — descarta trechos menores que isso

# Google Drive
DRIVE_FOLDER_ID=your_folder_id_here
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
