# URL do projeto Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key (Project Settings → API) — NUNCA a chave anon.
# Este servidor roda local/server-side e precisa ignorar RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: sem isso, o servidor ainda funciona com busca full-text,
# mas memory_search no modo "semantic"/"hybrid" cai para full-text puro.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
