# Já vem preenchido no código com valores reais e funcionais do
# projeto "memoria-grafo-dev" — só crie o .env se quiser sobrescrever
# (ex: apontar para outro projeto Supabase).

# URL da Edge Function "memory-api"
MEMORY_API_URL=https://bebewljjouhqwpzmgeks.supabase.co/functions/v1/memory-api

# Chave pública (anon) do projeto Supabase — não é secreta por design,
# é só o que o Supabase exige para aceitar a chamada na Edge Function.
# A service_role key de verdade nunca sai do lado do Supabase.
MEMORY_API_KEY=
